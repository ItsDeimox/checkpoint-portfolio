{
  "name": "heinem",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "HEINEM artist website \u2014 layered meadow, responsive soap-film shader and interactive CD player.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test --test-isolation=none tests/quality.test.ts tests/player.test.mjs tests/smooth-scroll.test.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
